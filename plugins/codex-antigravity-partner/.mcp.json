{
  "mcpServers": {
    "antigravity_partner": {
      "command": "node",
      "args": ["./server.mjs"],
      "cwd": ".",
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 1900,
      "tools": {
        "start_run": {
          "approval_mode": "prompt"
        },
        "create_unattended_grant": {
          "approval_mode": "prompt"
        },
        "cancel_run": {
          "approval_mode": "prompt"
        },
        "create_adjudication": {
          "approval_mode": "prompt"
        }
      }
    }
  }
}
