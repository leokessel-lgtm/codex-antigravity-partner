{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/codex-antigravity-partner/project-config.schema.json",
  "title": "Codex Antigravity project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project_id", "workspace_root", "allowed_paths", "allowed_permissions"],
  "properties": {
    "version": { "const": 1 },
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "workspace_root": { "type": "string", "minLength": 1 },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["sandbox", "accept-edits"] }
    },
    "sensitivity": {
      "type": "string",
      "enum": ["normal", "private", "high"],
      "default": "private"
    },
    "max_runtime_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 1800,
      "default": 300
    },
    "allow_unattended_approval": {
      "type": "boolean",
      "default": false
    },
    "allowed_models": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
